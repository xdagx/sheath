{
  "name": "sheath-xdag-wallet",
  "version": "1.0.0",
  "private": true,
  "description": "XDAG browser extension wallet (Chrome MV3) compatible with legacy 2018 wallet.dat and xdagj wallet.data files",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "mock-node": "node scripts/mock-node.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@preact/signals": "2.11.2",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "preact": "10.29.8",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/chrome": "0.3.0",
    "@types/node": "22.20.4",
    "typescript": "6.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
